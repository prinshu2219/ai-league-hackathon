# ── LLM ───────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ── Flight APIs ───────────────────────────────────────────
AMADEUS_API_KEY=your_amadeus_api_key_here
AMADEUS_API_SECRET=your_amadeus_api_secret_here
DUFFEL_API_KEY=your_duffel_api_key_here

# ── Transport ─────────────────────────────────────────────
ROME2RIO_API_KEY=your_rome2rio_api_key_here

# ── Accommodation ─────────────────────────────────────────
BOOKING_COM_API_KEY=your_booking_com_api_key_here
HOSTELWORLD_API_KEY=your_hostelworld_api_key_here

# ── Activities & Maps ─────────────────────────────────────
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
FOURSQUARE_API_KEY=your_foursquare_api_key_here

# ── Weather ───────────────────────────────────────────────
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
TOMORROW_IO_API_KEY=your_tomorrow_io_api_key_here

# ── Research & Tips ───────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=TravelPlannerBot/1.0

# ── Database (for trip history) ───────────────────────────
POSTGRES_USER=travel_agent
POSTGRES_PASSWORD=travel_agent_secret
POSTGRES_DB=travel_agent
# When running app locally with Postgres in Docker, use port 5433 (compose maps 5433:5432):
# DATABASE_URL=postgresql://travel_agent:travel_agent_secret@localhost:5433/travel_agent

# ── App Config ────────────────────────────────────────────
APP_ENV=development             # development | production
DEBUG=true
MAX_RETRIES=3
CACHE_TTL_SECONDS=3600          # 1 hour cache for API calls
