# LLM API keys
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Environment
APP_ENV=development
DEBUG=true

# Models — be specific in interviews
PRIMARY_MODEL=gpt-4o-mini
FALLBACK_MODEL=claude-3-5-sonnet-20241022
HARD_CASE_MODEL=gpt-4o

# Reliability
MAX_RETRIES=4
REQUEST_TIMEOUT=30
USE_ANTHROPIC_FALLBACK=true
USE_DOMAIN_ROUTER=true
DOMAIN_CONFIDENCE_THRESHOLD=0.85

# Context window
MAX_ARTICLE_CHARS=12000
CHUNK_SIZE=3000

# User rate limits (requests per minute)
FREE_TIER_RPM=10
PAID_TIER_RPM=100

# Circuit breaker
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN=60

# Production secrets (only when APP_ENV=production)
AWS_SECRET_NAME=prod/news-classifier/llm-keys
AWS_REGION=ap-south-1

# UI
API_URL=http://localhost:8000
